  <script type="application/json" id="dataset">{{ dataset_json | safe }}</script>
  <script>
    (function () {
      const DATA = JSON.parse(document.getElementById("dataset").textContent);
      const RECORDS = DATA.records;
      const ANALYTICS = DATA.analytics;
      let filteredCache = RECORDS.slice();

      const root = document.documentElement;
      const savedTheme = localStorage.getItem("theme");
      if (savedTheme === "dark" || savedTheme === "light") root.setAttribute("data-theme", savedTheme);
      document.getElementById("theme-toggle").addEventListener("click", () => {
        const isDark = root.getAttribute("data-theme") === "dark" ||
          (!root.getAttribute("data-theme") && window.matchMedia("(prefers-color-scheme: dark)").matches);
        const next = isDark ? "light" : "dark";
        root.setAttribute("data-theme", next);
        localStorage.setItem("theme", next);
      });

      const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
      const LABEL = {
        easy_win: "Easy win",
        moderate: "Moderate",
        needs_outreach: "Needs outreach",
        technically_blocked: "Technically blocked",
        supported: "Supported",
        partially_supported: "Partly supported",
        contradicted: "Contradicted",
        insufficient: "Insufficient",
        unknown: "Unknown",
        available: "In Composio",
        unavailable: "Not in Composio",
        self_serve_free: "Free self-serve",
        self_serve_trial: "Self-serve trial",
        paid_plan_required: "Paid plan",
        admin_approval: "Admin approval",
        partner_gated: "Partner gated",
        contact_sales: "Contact sales",
        partner_program: "Partner program",
        oauth_app_review: "OAuth app review",
        marketplace_listing: "Marketplace listing",
        none: "None",
        no_found: "None found",
        yes: "Yes",
        oauth2: "OAuth 2.0",
        api_key: "API key",
        basic: "Basic auth",
        bearer_token: "Bearer token",
        fixed: "Fixed by checks",
        regressed: "Made worse",
        abstained_to_wrong: "Guessed wrong",
        unchanged_correct: "Stayed correct",
        unchanged_wrong: "Stayed wrong",
        auth_methods: "Auth methods",
        credential_access: "Credentials",
        production_gate: "Ship gate",
        api_type: "API type",
        mcp_official: "Official MCP",
        main_blocker: "Main blocker",
        main_blocker_type: "Main blocker",
      };
      const fmtLabel = (s) => LABEL[s] || String(s || "unknown").replace(/_/g, " ");
      const fmtVal = (v) => Array.isArray(v) ? v.map(fmtLabel).join(", ") : (v && typeof v === "object" ? `${fmtLabel(v.type)}: ${v.text}` : fmtLabel(v ?? "unknown"));

      function statusBadge(status) {
        const cls = status === "supported" ? "badge--ok"
          : status === "partially_supported" ? "badge--warn"
          : status === "contradicted" ? "badge--err"
          : "badge--unk";
        return `<span class="badge ${cls}">${esc(fmtLabel(status))}</span>`;
      }

      function bucketBadge(bucket) {
        const cls = bucket === "easy_win" ? "badge--ok"
          : bucket === "moderate" ? "badge--warn"
          : bucket === "needs_outreach" ? "badge--warn"
          : "badge--err";
        return `<span class="badge ${cls}">${esc(fmtLabel(bucket))}</span>`;
      }

      function renderBarChart(id, title, sub, entries, total) {
        const rows = entries.map(([k, v]) => {
          const pct = total ? Math.round((100 * v) / total) : 0;
          const muted = k === "unknown" || k === "no_found" ? "bar-fill--muted" : "";
          return `<div class="bar-row">
            <span class="bar-label" title="${esc(fmtLabel(k))}">${esc(fmtLabel(k))}</span>
            <span class="bar-track"><span class="bar-fill ${muted}" style="width:${pct}%"></span></span>
            <span class="bar-val">${v}</span>
          </div>`;
        }).join("");
        return `<div class="chart-block" data-chart-id="${id}"><h3>${esc(title)}</h3><p class="chart-sub">${esc(sub)}</p>${rows}</div>`;
      }

      const d = ANALYTICS.distributions;
      const n = ANALYTICS.summary.total_apps || 100;
      const sortDesc = (obj) => Object.entries(obj || {}).sort((a, b) => b[1] - a[1]);

      document.getElementById("pattern-charts").innerHTML = [
        renderBarChart("auth", "How apps authenticate", `${d.auth_methods.multi_method_apps} of ${n} apps offer two or more auth methods (an app can appear in more than one bar).`, sortDesc(d.auth_methods.by_method), n),
        renderBarChart("access", "How you get credentials", "Can a developer sign up alone, or is a paid plan / admin / partner required?", sortDesc(d.credential_access), n),
        renderBarChart("gate", "Extra gates before you can ship", `${d.production_gate.gated_despite_free_dev} apps with free developer signup still need review or a partner program to serve many customers.`, sortDesc(d.production_gate.by_value), n),
        renderBarChart("mcp", "MCP servers and Composio coverage", `${ANALYTICS.mcp_vs_composio.official_mcp_without_composio.length} apps already ship an official MCP server but are not in Composio yet.`, [
          ["Has official MCP", d.mcp_official.yes || 0],
          ["In Composio catalog", d.composio_toolkit.available || 0],
          ["Has third-party MCP", d.mcp_third_party.yes || 0],
          ["Official MCP, not in Composio", ANALYTICS.mcp_vs_composio.official_mcp_without_composio.length],
        ], n),
      ].join("");

      function applyChartVisibility() {
        document.querySelectorAll(".chart-toggle").forEach((cb) => {
          const block = document.querySelector(`.chart-block[data-chart-id="${cb.dataset.chart}"]`);
          if (block) block.hidden = !cb.checked;
        });
        const heat = document.getElementById("heatmap-block");
        if (heat) heat.hidden = !document.getElementById("heatmap-toggle").checked;
      }
      document.querySelectorAll(".chart-toggle").forEach((cb) => cb.addEventListener("change", applyChartVisibility));
      document.getElementById("heatmap-toggle").addEventListener("change", applyChartVisibility);

      const accessCols = ["self_serve_free", "self_serve_trial", "paid_plan_required", "admin_approval", "partner_gated", "contact_sales", "unknown"];
      const mat = ANALYTICS.matrices.category_x_credential_access;
      const heatRows = Object.entries(mat).map(([cat, row]) => {
        const cells = accessCols.map((col) => {
          const v = row[col] || 0;
          const alpha = v ? Math.min(0.28, 0.04 + v * 0.035) : 0;
          const bg = v ? `background: rgb(128 128 128 / ${Math.round(alpha * 100)}%);` : "";
          return `<td class="heat-cell" style="${bg}">${v || "·"}</td>`;
        }).join("");
        return `<tr><td>${esc(cat)}</td>${cells}</tr>`;
      }).join("");
      document.getElementById("heatmap-wrap").innerHTML = `<table>
        <thead><tr><th>Category</th>${accessCols.map((c) => `<th style="text-align:center;">${esc(fmtLabel(c))}</th>`).join("")}</tr></thead>
        <tbody>${heatRows}</tbody>
      </table>`;

      function applyOppFilters() {
        const gapsOnly = document.getElementById("opp-gaps-only").checked;
        const bucket = document.getElementById("opp-bucket-filter").value;
        document.querySelectorAll("[data-opp-bucket]").forEach((col) => {
          const showCol = !bucket || col.dataset.oppBucket === bucket;
          col.style.display = showCol ? "" : "none";
          if (!showCol) return;
          let visible = 0;
          col.querySelectorAll(".chip[data-jump-app]").forEach((chip) => {
            const isGap = chip.dataset.composio !== "available";
            const show = !gapsOnly || isGap;
            chip.classList.toggle("chip--hidden", !show);
            if (show) visible += 1;
          });
          const countEl = col.querySelector("[data-opp-count]");
          if (countEl) countEl.textContent = String(visible);
        });
      }
      document.getElementById("opp-gaps-only").addEventListener("change", applyOppFilters);
      document.getElementById("opp-bucket-filter").addEventListener("change", applyOppFilters);

      const selCat = document.getElementById("f-category");
      const selAuth = document.getElementById("f-auth");
      const selAccess = document.getElementById("f-access");
      const selGate = document.getElementById("f-gate");
      const selApi = document.getElementById("f-api");

      const uniq = (arr) => [...new Set(arr)].sort();
      uniq(RECORDS.map((r) => r.claims.category.value)).forEach((v) => selCat.add(new Option(v, v)));
      uniq(RECORDS.flatMap((r) => r.claims.auth_methods.value)).forEach((v) => selAuth.add(new Option(fmtLabel(v), v)));
      uniq(RECORDS.map((r) => r.claims.credential_access.value)).forEach((v) => selAccess.add(new Option(fmtLabel(v), v)));
      uniq(RECORDS.map((r) => r.claims.production_gate.value)).forEach((v) => selGate.add(new Option(fmtLabel(v), v)));
      uniq(RECORDS.flatMap((r) => r.claims.api_type.value)).forEach((v) => selApi.add(new Option(fmtLabel(v), v)));

      const openApps = new Set();
      const colVisible = {
        score: true, bucket: true, auth: true, access: true,
        gate: true, mcp: true, composio: true, confidence: true,
      };

      function applyColumnVisibility() {
        document.querySelectorAll("#explorer-table [data-col]").forEach((el) => {
          const key = el.getAttribute("data-col");
          if (key === "id" || key === "app" || key === "category") {
            el.classList.remove("col-hidden");
            return;
          }
          el.classList.toggle("col-hidden", !colVisible[key]);
        });
      }

      document.querySelectorAll(".col-toggle").forEach((cb) => {
        cb.addEventListener("change", () => {
          colVisible[cb.dataset.col] = cb.checked;
          applyColumnVisibility();
        });
      });

      function renderDetail(r) {
        const claimsHtml = Object.entries(r.claims).map(([name, c]) => {
          const evs = (c.evidence || []).slice(0, 2).map((e) =>
            `<div class="claim-quote">“${esc(e.quote)}”<div class="claim-meta"><a href="${esc(e.url)}" target="_blank" rel="noopener">${esc(e.url)}</a> · ${esc(fmtLabel(e.source_tier))}</div></div>`
          ).join("");
          const loops = (c.verification?.loops || []).map((l) => `${l.loop}:${l.result}`).join(" · ");
          return `<div class="claim-item">
            <div class="claim-top"><span class="claim-name">${esc(fmtLabel(name))}</span>${statusBadge(c.verification?.status || "unknown")}</div>
            <div class="claim-val">${esc(fmtVal(c.value))}</div>
            ${evs || '<div class="claim-meta">No evidence (unknown)</div>'}
            ${loops ? `<div class="claim-meta">Checks: ${esc(loops)}</div>` : ""}
          </div>`;
        }).join("");

        const bd = r.buildability.breakdown || {};
        const bdRows = Object.entries(bd).map(([k, v]) =>
          `<tr><td>${esc(fmtLabel(k))}</td><td class="num">${v.score}/2</td><td>${esc(v.driver)}</td></tr>`
        ).join("");
        return `<div class="detail-grid">
          <div><h3>Answers and the docs behind them</h3>${claimsHtml}</div>
          <div>
            <h3>Why the score is ${r.buildability.score}/10 (${esc(fmtLabel(r.buildability.verdict))})</h3>
            <p class="chart-sub">Needs partnership or sales contact: <strong>${r.buildability.commercial_gate ? "Yes" : "No"}</strong> · Group: <strong>${esc(fmtLabel(r.buildability.bucket))}</strong></p>
            <table><thead><tr><th>Factor</th><th class="num">Points</th><th>Why</th></tr></thead><tbody>${bdRows}</tbody></table>
            ${r.errors?.length ? `<p class="claim-meta" style="margin-top:12px;">Notes: ${esc(r.errors.join("; "))}</p>` : ""}
          </div>
        </div>`;
      }

      function sortRecords(list) {
        const mode = document.getElementById("f-sort").value;
        const sorted = list.slice();
        const cmpStr = (a, b) => String(a).localeCompare(String(b));
        sorted.sort((a, b) => {
          if (mode === "id-desc") return b.app_id - a.app_id;
          if (mode === "score-desc") return b.buildability.score - a.buildability.score || a.app_id - b.app_id;
          if (mode === "score-asc") return a.buildability.score - b.buildability.score || a.app_id - b.app_id;
          if (mode === "name-asc") return cmpStr(a.app, b.app);
          if (mode === "name-desc") return cmpStr(b.app, a.app);
          if (mode === "category-asc") return cmpStr(a.claims.category.value, b.claims.category.value) || cmpStr(a.app, b.app);
          return a.app_id - b.app_id;
        });
        return sorted;
      }

      function renderExplorer() {
        const q = document.getElementById("f-search").value.trim().toLowerCase();
        const cat = selCat.value, bk = document.getElementById("f-bucket").value, vd = document.getElementById("f-verdict").value;
        const au = selAuth.value, ac = selAccess.value, gt = selGate.value, ap = selApi.value;
        const mcp = document.getElementById("f-mcp").value, comp = document.getElementById("f-composio").value;
        const vst = document.getElementById("f-vstatus").value;

        const filtered = RECORDS.filter((r) => {
          const c = r.claims;
          if (q && !`${r.app} ${c.category.value} ${c.main_blocker.value.text} ${r.app_id}`.toLowerCase().includes(q)) return false;
          if (cat && c.category.value !== cat) return false;
          if (bk && r.buildability.bucket !== bk) return false;
          if (vd && r.buildability.verdict !== vd) return false;
          if (au && !c.auth_methods.value.includes(au)) return false;
          if (ac && c.credential_access.value !== ac) return false;
          if (gt && c.production_gate.value !== gt) return false;
          if (ap && !c.api_type.value.includes(ap)) return false;
          if (mcp && c.mcp_official.value !== mcp) return false;
          if (comp && r.composio_toolkit.value !== comp) return false;
          if (vst) {
            const statuses = Object.values(c).filter((cl) => {
              const v = cl.value;
              return !(v === "unknown" || (Array.isArray(v) && v.length === 1 && v[0] === "unknown") || (v && v.type === "unknown"));
            }).map((cl) => cl.verification?.status);
            const hasFlag = statuses.some((s) => s && s !== "supported");
            if (vst === "all_supported" && hasFlag) return false;
            if (vst === "has_flagged" && !hasFlag) return false;
          }
          return true;
        });

        filteredCache = sortRecords(filtered);
        document.getElementById("explorer-count").textContent = `Showing ${filteredCache.length} of ${RECORDS.length} apps`;
        const tbody = document.getElementById("explorer-body");
        tbody.innerHTML = filteredCache.map((r) => {
          const c = r.claims;
          const isOpen = openApps.has(r.app_id);
          const confCls = r.record_confidence === "high" ? "badge--ok" : r.record_confidence === "medium" ? "badge--warn" : "badge--unk";
          const compBadge = r.composio_toolkit.value === "available"
            ? `<span class="badge badge--ok">In Composio</span>`
            : `<span class="badge badge--solid">Not in Composio</span>`;
          return `<tr class="exp-row" data-app-id="${r.app_id}" id="app-row-${r.app_id}">
            <td class="num" data-col="id">${r.app_id}</td>
            <td data-col="app"><strong>${esc(r.app)}</strong></td>
            <td data-col="category">${esc(c.category.value)}</td>
            <td class="num" data-col="score">${r.buildability.score}/10</td>
            <td data-col="bucket">${bucketBadge(r.buildability.bucket)}</td>
            <td data-col="auth">${esc(c.auth_methods.value.join(", "))}</td>
            <td data-col="access">${c.credential_access.value === "unknown" ? '<span class="badge badge--unk">unknown</span>' : esc(fmtLabel(c.credential_access.value))}</td>
            <td data-col="gate">${c.production_gate.value === "unknown" ? '<span class="badge badge--unk">unknown</span>' : esc(fmtLabel(c.production_gate.value))}</td>
            <td data-col="mcp">${esc(fmtLabel(c.mcp_official.value))}</td>
            <td data-col="composio">${compBadge}</td>
            <td data-col="confidence"><span class="badge ${confCls}">${esc(r.record_confidence)}</span></td>
          </tr>
          <tr class="exp-detail ${isOpen ? "is-open" : ""}" data-detail-id="${r.app_id}">
            <td colspan="11">${isOpen ? renderDetail(r) : ""}</td>
          </tr>`;
        }).join("");
        applyColumnVisibility();
      }

      document.getElementById("explorer-body").addEventListener("click", (ev) => {
        const tr = ev.target.closest("tr.exp-row");
        if (!tr) return;
        const id = Number(tr.dataset.appId);
        const detailTr = document.querySelector(`tr[data-detail-id="${id}"]`);
        if (openApps.has(id)) {
          openApps.delete(id);
          detailTr.classList.remove("is-open");
        } else {
          openApps.add(id);
          const rec = RECORDS.find((r) => r.app_id === id);
          if (rec && !detailTr.firstElementChild.innerHTML) detailTr.firstElementChild.innerHTML = renderDetail(rec);
          detailTr.classList.add("is-open");
        }
      });

      ["f-search", "f-category", "f-bucket", "f-verdict", "f-auth", "f-access", "f-gate", "f-api", "f-mcp", "f-composio", "f-vstatus", "f-sort"].forEach((id) => {
        document.getElementById(id).addEventListener("input", renderExplorer);
        document.getElementById(id).addEventListener("change", renderExplorer);
      });
      document.getElementById("f-reset").addEventListener("click", () => {
        ["f-search", "f-category", "f-bucket", "f-verdict", "f-auth", "f-access", "f-gate", "f-api", "f-mcp", "f-composio", "f-vstatus"].forEach((id) => {
          document.getElementById(id).value = "";
        });
        document.getElementById("f-sort").value = "id-asc";
        renderExplorer();
      });

      document.getElementById("f-export").addEventListener("click", () => {
        const cols = ["app_id", "app", "category", "score", "bucket", "verdict", "auth_methods", "credential_access", "production_gate", "mcp_official", "composio_toolkit", "confidence"];
        const lines = [cols.join(",")];
        filteredCache.forEach((r) => {
          const c = r.claims;
          const row = [
            r.app_id,
            `"${String(r.app).replace(/"/g, '""')}"`,
            `"${String(c.category.value).replace(/"/g, '""')}"`,
            r.buildability.score,
            r.buildability.bucket,
            r.buildability.verdict,
            `"${c.auth_methods.value.join("; ")}"`,
            c.credential_access.value,
            c.production_gate.value,
            c.mcp_official.value,
            r.composio_toolkit.value,
            r.record_confidence,
          ];
          lines.push(row.join(","));
        });
        const blob = new Blob([lines.join("\n")], { type: "text/csv;charset=utf-8" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `apps-filtered-${filteredCache.length}.csv`;
        a.click();
        URL.revokeObjectURL(url);
      });

      document.addEventListener("click", (ev) => {
        const btn = ev.target.closest("[data-jump-app]");
        if (!btn) return;
        const id = Number(btn.dataset.jumpApp);
        document.getElementById("f-reset").click();
        openApps.add(id);
        renderExplorer();
        const row = document.getElementById(`app-row-${id}`);
        if (row) row.scrollIntoView({ behavior: "smooth", block: "center" });
      });

      const goldenClaims = DATA.attribution?.claims || [];
      function renderGolden() {
        const mode = document.getElementById("golden-filter").value;
        const rows = goldenClaims.filter((c) => {
          if (mode === "all") return true;
          if (mode === "misses") return c.after_outcome !== "correct";
          return c.transition === mode;
        });
        document.getElementById("golden-body").innerHTML = rows.map((c) => {
          const cls = c.transition === "fixed" || c.transition === "unchanged_correct" ? "badge--ok"
            : c.transition === "regressed" ? "badge--err"
            : c.after_outcome === "abstained" ? "badge--unk" : "badge--warn";
          return `<tr>
            <td>${esc(c.app)}</td>
            <td><code>${esc(c.field)}</code></td>
            <td><code>${esc(fmtVal(c.golden))}</code></td>
            <td><code>${esc(fmtVal(c.before_value))}</code></td>
            <td><code>${esc(fmtVal(c.after_value))}</code></td>
            <td><span class="badge ${cls}">${esc(fmtLabel(c.transition))}</span></td>
            <td>${esc((c.responsible_loops || []).join(", ") || "—")}</td>
          </tr>`;
        }).join("");
      }
      document.getElementById("golden-filter").addEventListener("change", renderGolden);

      renderExplorer();
      renderGolden();
      applyChartVisibility();
      applyOppFilters();
    })();
  </script>
</body>
</html>
