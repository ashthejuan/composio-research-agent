              {% for a in analytics.opportunities.outreach_targets %}
              <button type="button" class="chip {% if a.composio_toolkit != 'available' %}chip--gap{% endif %}" data-jump-app="{{ a.app_id }}" title="Score {{ a.score }}/10 · {{ a.credential_access }} / {{ a.production_gate }}">
                {{ a.app }} <span class="chip-score">{{ a.score }}</span>
              </button>
              {% endfor %}
            </div>
          </div>

          <div class="bucket-col">
            <div class="bucket-head">
              <h3>Moderate effort</h3>
              <span class="bucket-count">{{ analytics.opportunities.moderate|length }}</span>
            </div>
