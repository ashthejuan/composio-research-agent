                    <th class="num">Checked</th>
                    <th class="num">Flagged</th>
                    <th class="num">Changed</th>
                    <th class="num">Golden fixes</th>
                  </tr>
                </thead>
                <tbody>
                  {% for lp in ["L1", "L2", "L3", "L4", "L5", "L6"] %}
                  {% set d = loop_stats.all_claims.loops[lp] %}
                  <tr>
                    <td><code>{{ lp }}</code></td>
                    <td class="num">{{ d.claims_checked }}</td>
                    <td class="num">{{ d.flagged }}</td>
                    <td class="num">{{ d.values_changed }}</td>
                    <td class="num">{{ attribution.errors_caught_per_loop.credited[lp] }}</td>
                  </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
            <p class="kpi-note" style="margin-top: 10px;">
              Golden transitions (Pass 1 → Pass 2): {{ attribution.transitions.fixed or 0 }} fixed, {{ attribution.transitions.regressed or 0 }} regressed, {{ attribution.transitions.abstained_to_wrong or 0 }} abstained → wrong, {{ attribution.transitions.unchanged_correct or 0 }} unchanged correct.
            </p>
          </div>
        </div>

        <div class="split-2">
