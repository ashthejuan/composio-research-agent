    <section id="verification" class="chapter">
      <div class="wrap">
        <div class="chapter-head">
          <div class="chapter-num">05 / Verification &amp; accuracy</div>
          <h2>Measured against a 20-app human-confirmed golden set</h2>
          <p class="lead">
            All three passes are scored with the exact same frozen rules file (<code>{{ acc2.rules_sha256[:12] }}…</code>). Pass 2 is strictly automated (no human edits). Final is reported separately and labelled as human-corrected.
          </p>
        </div>

        <div class="split-2">
          <div>
            <h3>Per-field accuracy progression</h3>
            <p class="chart-sub">20 golden apps × 6 evaluated fields = 120 claims (0 excluded).</p>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Field</th>
                    <th class="num">Pass 1 (raw)</th>
                    <th class="num">Pass 2 (auto)</th>
                    <th class="num">Delta</th>
                    <th class="num">Final (human)</th>
                  </tr>
                </thead>
                <tbody>
                  {% for fname in acc1.per_field.keys() %}
                  {% set p1 = acc1.per_field[fname].accuracy %}
                  {% set p2 = acc2.per_field[fname].accuracy %}
                  {% set pf = accf.per_field[fname].accuracy %}
                  {% set diff = p2 - p1 %}
                  <tr>
                    <td><code>{{ fname }}</code></td>
                    <td class="num">{{ "%.1f"|format(p1) }}%</td>
                    <td class="num">{{ "%.1f"|format(p2) }}%</td>
                    <td class="num">{% if diff > 0 %}+{% endif %}{{ "%.1f"|format(diff) }} pp</td>
                    <td class="num">{{ "%.1f"|format(pf) }}%</td>
                  </tr>
                  {% endfor %}
                  <tr style="font-weight: 500;">
                    <td>Overall (120 claims)</td>
                    <td class="num">{{ "%.1f"|format(acc1.overall.accuracy) }}%</td>
                    <td class="num">{{ "%.2f"|format(acc2.overall.accuracy) }}%</td>
                    <td class="num">+{{ "%.2f"|format(acc2.overall.accuracy - acc1.overall.accuracy) }} pp</td>
                    <td class="num">{{ "%.1f"|format(accf.overall.accuracy) }}%</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div>
            <h3>Verification loops (L1–L6) across all 100 apps</h3>
            <p class="chart-sub">1,600 total claims checked; golden attribution shows fixes credited per loop.</p>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
