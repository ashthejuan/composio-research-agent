# Copy to .env and fill in. Never commit .env.
# COMPOSIO_API_KEY=
# OPENAI_API_KEY=
# META_API_KEY=            # Meta Model API key (https://api.meta.ai/v1)
# EXA_API_KEY=             # fallback only (TOOL_BACKEND=direct)

TOOL_BACKEND=composio
# Default OpenAI model for extraction; configurable.
EXTRACTOR_MODEL=gpt-5
VERIFIER_MODEL=muse-spark-1.3-contributor
CONCURRENCY=8
COMPOSIO_USER_ID=app-intel-agent
# Account used for EXA/FIRECRAWL tools: "instant_account" (Composio-managed, billed to Composio balance)
# or a connected account id (ca_...). Set empty to let Composio resolve the user's own connection.
COMPOSIO_ACCOUNT=instant_account
# Extractor price in USD per 1M tokens, used for run-manifest cost totals (0 / cost_priced=false if unset).
# EXTRACTOR_PRICE_IN=
# EXTRACTOR_PRICE_OUT=
# Max in-flight Exa search requests across the whole run (direct backend).
# EXA_MAX_INFLIGHT=5
