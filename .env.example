# Copy to .env and fill in. Never commit .env.
# COMPOSIO_API_KEY=       # consumer key `ck_...` -> Composio Connect MCP (header x-consumer-api-key),
#                          #   connect toolkits with `python -m agent composio connect exa`;
#                          # or project key `ak_...` -> Composio Python SDK (TOOL_BACKEND=composio auto-detects).
# OPENAI_API_KEY=
# META_API_KEY=   # Meta Model API (dev.meta.ai), verifier
# EXA_API_KEY=             # fallback only (TOOL_BACKEND=direct)

# composio (auto: ck_ -> MCP, ak_ -> SDK) | composio_sdk (force SDK) | direct (Exa SDK + httpx)
TOOL_BACKEND=composio
# Empty = no fallback (Composio errors surface). "direct" = on a missing/broken Composio connection or
# repeated errors, log one WARNING and use the direct tools; counts land in the manifest tool_backend_counts.
TOOL_FALLBACK=
COMPOSIO_MCP_URL=https://connect.composio.dev/mcp
# Max in-flight Composio MCP tool executions across the whole run.
COMPOSIO_MAX_INFLIGHT=5
# Default OpenAI model for extraction; configurable.
EXTRACTOR_MODEL=gpt-6-luna
VERIFIER_MODEL=muse-spark-1.3-contributor
VERIFIER_BASE_URL=https://api.meta.ai/v1
CONCURRENCY=8
COMPOSIO_USER_ID=app-intel-agent
# SDK path (ak_ keys) only; ignored by the consumer-key MCP path. Account used for EXA/FIRECRAWL tools:
# "instant_account" (Composio-managed) or a connected account id (ca_...). Empty = user's own connection.
COMPOSIO_ACCOUNT=instant_account
# Extractor price in USD per 1M tokens, used for run-manifest cost totals (0 / cost_priced=false if unset).
# EXTRACTOR_PRICE_IN=
# EXTRACTOR_PRICE_OUT=
# Max in-flight Exa search requests across the whole run (direct backend).
# EXA_MAX_INFLIGHT=5
